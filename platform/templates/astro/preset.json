{
  "steps": [
    {
      "type": "copy"
    },
    {
      "type": "patch",
      "properties": {
        "file": "tsconfig.json",
        "patch": [
          {
            "op": "add",
            "path": "/exclude/-",
            "value": "neo.config.ts"
          }
        ]
      }
    },
    {
      "type": "npm",
      "properties": {
        "file": "package.json",
        "package": "neo"
      }
    },
    {
      "type": "npm",
      "properties": {
        "file": "package.json",
        "package": "astro-neo"
      }
    },
    {
      "type": "instructions",
      "properties": [
        "Next steps: update astro.config.mjs",
        "",
        "import aws from \"astro-neo\";",
        "export default defineConfig({",
        "  output: \"server\",",
        "  adapter: aws()",
        "});"
      ]
    }
  ]
}
