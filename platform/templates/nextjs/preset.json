{
  "steps": [
    {
      "type": "copy"
    },
    {
      "type": "patch",
      "properties": {
        "file": "tsconfig.json",
        "patch": [
          {
            "op": "add",
            "path": "/exclude/-",
            "value": "neo.config.ts"
          }
        ]
      }
    },
    {
      "type": "npm",
      "properties": {
        "file": "package.json",
        "package": "neo"
      }
    },
    {
      "type": "gitignore",
      "properties": {
        "name": "# open-next",
        "path": ".open-next"
      }
    }
  ]
}
